pipeline {
    agent any

    tools {
        maven 'maven3'
        jdk 'jdk17'
    }

    environment{
        DOCKERHUB_USERNAME = 'vicky1867'
        DOCKER_IMAGE = "${DOCKERHUB_USERNAME}/vickstudio:v1"
    }

    stages {
        stage('gitcheckout') {
            steps { 
                echo 'pulling the code'
                git branch: 'feature',
                git 'https://github.com/Varcoder-123/Java-3-tier-Application.git
            }
        }
        stage('Compile') {
            steps {
                echo 'Compiling the application...'
                dir('Java-Login-App') {
                    sh 'mvn clean compile'
                }
            }
        }
        stage('Unit Test') {
            steps {
                echo 'Running unit tests...'
                dir('Java-Login-App') {
                    sh 'mvn test'
                }
            }
        }
        stage('package') {
            steps {
                echo 'Building the code'
                dir('Java-Login-App') {
                    sh 'mvn package'
                }
            }
        }
        stage('SonarQube Analysis') {
            steps {
                echo 'Analysis completed'
                dir('Java-Login-App') {
                    withSonarQubeEnv('Sonar-qube-servers') {
                    sh 'mvn sonar:sonar'
                }
              }
            }
        }
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        stage('Docker image') {
            steps {
                script{
                    echo 'docker build'
                    sh 'docker build -t ${DOCKER_IMAGE} .'
                }
            }
        }
        stage('Docker Push') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'docker-pass', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
                    sh '''
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push ${DOCKER_IMAGE}
                        docker logout
                        '''
                    } 
                }
            }
        }
    }
}