pipeline {
    agent any

    tools {
        maven 'maven3'
        jdk 'jdk17'
    }

    environment{
        DOCKERHUB_USERNAME = 'vicky1867'
        DOCKER_IMAGE = "${DOCKERHUB_USERNAME}/vickstudio:v1"
    }

    stages {
        stage('gitcheckout') {
            steps { 
                echo 'pulling the code'
                git branch: 'feature', url: 'https://github.com/Varcoder-123/Java-3-tier-Application.git'
            }
        }
        stage('Compile') {
            steps {
                echo 'Compiling the application...'
                dir('Java-Login-App') {
                    sh 'mvn clean compile'
                }
            }
        }
        stage('Unit Test') {
            steps {
                echo 'Running unit tests...'
                dir('Java-Login-App') {
                    sh 'mvn test'
                }
            }
        }
        stage('OWASP Dependency Check') {
            steps {
                echo 'Running OWASP Dependency Check...'
                    dependencyCheck additionalArguments: '--scan Java-Login-App', nvdCredentialsId: 'OWASP', odcInstallation: 'DependencyCheck'
            }
        }
        stage('Publish Dependency Report') {
            steps {
                echo 'Publishing Dependency Check Report...'               
                    dependencyCheckPublisher pattern: '**/dependency-check-report.xml' 
            }
        }
        stage('SonarQube Analysis') {
            steps {
                echo 'Analysis completed'
                dir('Java-Login-App') {
                    withSonarQubeEnv('Sonar-qube-servers') {
                    sh 'mvn sonar:sonar'
                }
              }
            }
        }
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        stage('package') {
            steps {
                echo 'Building the code'
                dir('Java-Login-App') {
                    sh 'mvn package'
                }
            }
        }
        stage('Upload the artifacts the nexus') {
            steps {
                echo 'Upload the artifacts the nexus'
                dir('Java-Login-App'){
                withMaven(globalMavenSettingsConfig: 'settings.xml', jdk: 'jdk17', maven: 'maven3', traceability: true) {
                    sh 'mvn deploy'
                }
              }
            }
        }
        stage('Trivy Scan') {
            steps {
                echo 'Scanning Docker Image...'
                sh 'trivy image ${DOCKER_IMAGE}'
            }
        }
        stage('Docker image') {
            steps {
                script{
                    echo 'docker build'
                    sh 'docker build -t ${DOCKER_IMAGE} .'
                }
            }
        }
        stage('Docker Push') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'docker-pass', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
                    sh '''
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push ${DOCKER_IMAGE}
                        docker logout
                        '''
                    } 
                }
            }
        }
    }
}